# NER-SHIELD Frontend - example environment.
# Copy to `.env.local` (git-ignored) and adjust if the backend isn't on its default port.

# Base URL of the NER-SHIELD Spring Boot backend (see `backend/`). The Global Threat
# Intelligence map calls `${NEXT_PUBLIC_API_BASE_URL}/api/threats` directly (the backend's
# CORS policy already allows this origin — see `backend/.env.example`'s
# CORS_ALLOWED_ORIGINS). Falls back to demonstration data client-side if the backend is
# unreachable, so this only needs to be set once the backend is actually running.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional. Domains not yet backed by a real endpoint (field reports, alerts, simulations,
# GIS layers) go through services/http.ts's mock transport by default. Set this to "false"
# once those are wired up too; it has no effect on threats, risk zones or incidents, which
# always call the real backend (with an automatic demo-data fallback if it's unreachable).
NEXT_PUBLIC_USE_MOCK=true

# Optional. Nominatim-compatible geocoding endpoint for the Command Center's location
# search (countries, states, cities, districts, villages, landmarks). Defaults to the
# public OSM Nominatim instance — free, no API key required — if unset. Point this at a
# self-hosted Nominatim instance or a backend proxy if you need higher request volume.
NEXT_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org

# Optional. Full URLs to the three homepage hero background clips, served from a
# CDN/blob store (Vercel Blob, Cloudinary, S3 + CloudFront, Cloudflare R2, etc.)
# instead of this app's own deploy bundle — the combined source video is ~99MB,
# which is what was slowing down deploys and first load. Leave unset to fall back
# to the copies bundled in `public/` (fine for local dev, not recommended for
# production). Set all three once you've uploaded the clips.
NEXT_PUBLIC_HERO_VIDEO_1=
NEXT_PUBLIC_HERO_VIDEO_2=
NEXT_PUBLIC_HERO_VIDEO_3=
