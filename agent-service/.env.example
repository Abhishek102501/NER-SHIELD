# NER-SHIELD Agent Service — example environment.
# Copy to `.env` (git-ignored) and fill in real values. No real credentials belong here.

# --- Service ---
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8100

# --- Backend (Spring Boot — sole source of truth for reads/writes) ---
BACKEND_BASE_URL=http://localhost:8085
BACKEND_REQUEST_TIMEOUT_SECONDS=8.0

# --- LLM provider ---
# "anthropic" (real) or "none" (default — the agent honestly reports unavailable
# rather than fabricating a response; see llm/factory.py).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOOL_ITERATIONS=6

# --- Embeddings (for RAG ingestion + query) ---
# "voyage" (real, via Voyage AI's REST API — Anthropic's recommended embeddings
# partner) or "none" (default).
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3

# --- RAG / vector store ---
# Same PostgreSQL instance as the main backend, isolated "agent" schema (see
# backend/src/main/resources/db/migration/V5__agent_rag_schema.sql). Leave empty to
# disable RAG entirely (search_knowledge_base then reports unavailable).
#
# NOTE: pgvector is NOT installed on this project's PostgreSQL 16 instance (confirmed —
# no vector.control/vector.dll present). The RAG store therefore stores embeddings as
# plain double precision[] columns and computes cosine similarity in Python rather than
# using pgvector's <-> operator — see rag/store.py's module docstring for the exact
# migration path once the extension is installed.
RAG_DATABASE_URL=postgresql://nershield:<db-password>@localhost:5433/nershield
