# NER-SHIELD Backend - example environment.
# Copy to `.env` (git-ignored) and fill in real values, or export these in your shell
# before starting the application. No real credentials belong in this file.

# --- HTTP ---
SERVER_PORT=8080

# --- PostgreSQL + PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nershield
DB_USERNAME=nershield
DB_PASSWORD=
DB_POOL_MAX_SIZE=10

# --- Flyway ---
FLYWAY_ENABLED=true

# --- CORS (comma separated origins for the Next.js frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Python AI service (landslide + rainfall inference) ---
AI_SERVICE_BASE_URL=http://localhost:8000

# --- AI Disaster Response Agent (separate agent-service process) ---
AGENT_SERVICE_BASE_URL=http://localhost:8100

# --- Weather (Open-Meteo: free, real, no API key required) ---
# "open-meteo" (default) or "none" to disable the endpoint entirely (it then honestly
# returns available=false instead of fabricating a reading — see WeatherService).
WEATHER_PROVIDER=open-meteo
WEATHER_API_URL=https://api.open-meteo.com

# --- JWT (authentication is not implemented yet; see backend/README.md) ---
JWT_ISSUER=ner-shield
# JWT_SECRET must be set once JWT authentication is implemented.
JWT_SECRET=
