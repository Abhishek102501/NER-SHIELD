# NER-SHIELD Backend - example environment.
# Copy to `.env` (git-ignored) and fill in real values, or export these in your shell
# before starting the application. No real credentials belong in this file.

# --- HTTP ---
SERVER_PORT=8080

# --- PostgreSQL + PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nershield
DB_USERNAME=nershield
DB_PASSWORD=
DB_POOL_MAX_SIZE=10

# --- Flyway ---
FLYWAY_ENABLED=true

# --- CORS (comma separated origins for the Next.js frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Python AI service (not implemented yet) ---
AI_SERVICE_BASE_URL=http://localhost:8000

# --- JWT (authentication is not implemented yet; see backend/README.md) ---
JWT_ISSUER=ner-shield
# JWT_SECRET must be set once JWT authentication is implemented.
JWT_SECRET=
