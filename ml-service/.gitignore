# Local environment
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/

# Model artifacts and data — trained locally, not committed. Keep the
# directories themselves via .gitkeep.
models/*
!models/.gitkeep
data/*
!data/.gitkeep

# Test/tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
