# NER-SHIELD ML service — example environment. Copy to `.env` (git-ignored).
# No secrets belong here or in `.env` — this service has none yet (no external
# API keys, no database credentials). Keep it that way; if a future step adds
# one, it goes in `.env`/a secrets manager, never committed.

# Host/port the FastAPI service binds to. The Spring Boot backend's
# AI_SERVICE_BASE_URL (see backend/.env.example) defaults to
# http://localhost:8000 — keep this in sync if you change it.
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Where trained model artifacts are read from / written to.
MODEL_DIR=./models

# Where training data (CSV/GeoParquet of hazard zones) is read from.
DATA_DIR=./data

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Landslide4Sense (see src/nershield_ml/landslide4sense/) ---
# real   = run the actual U-Net checkpoint at LANDSLIDE_MODEL_PATH.
# mock   = deterministic, clearly-labeled placeholder pipeline (no checkpoint
#          needed); every API response carries mode="mock" so callers can
#          never mistake it for a real prediction.
#
# The official IARAI pretrained checkpoint is no longer downloadable
# (iarai.ac.at / cloud.iarai.ac.at are offline as of 2026-09) and no other
# publicly hosted checkpoint shares this exact from-scratch architecture (see
# ml-service/scripts/train_landslide4sense.py's module docstring for the
# compatibility survey). A real checkpoint was instead TRAINED HERE on the
# official Landslide4Sense-2022 dataset (Zenodo record 10463239, 3799 train /
# 245 valid patches, MIT/CC-BY-4.0) using scripts/train_landslide4sense.py.
# CPU-only training, time-capped: 2 epochs completed before the time budget
# was exhausted (best = epoch 1). Measured on the full 245-patch validation
# split: precision=0.203, recall=0.834, F1=0.327, IoU=0.195. This is a real,
# working, GENUINELY WEAK checkpoint (heavily over-predicts landslide area) —
# not a strong model. It is honestly wired in as real rather than hidden,
# per this project's "weak-but-real, plainly labeled" convention (see the
# northeast_smoke_test_DO_NOT_USE.pt precedent below). Re-running the
# training script for more epochs/time would likely improve it further.
LANDSLIDE_INFERENCE_MODE=real

# Path to a Landslide4Sense U-Net checkpoint compatible with
# model/unet.py's unet(n_classes=2, n_channels=14). Required only when
# LANDSLIDE_INFERENCE_MODE=real. Not shipped in this repo (models/ is
# gitignored) — train your own with scripts/train_landslide4sense.py (see
# above) or place a compatible .pt/.pth checkpoint here yourself.
LANDSLIDE_MODEL_PATH=./models/landslide/landslide4sense_unet.pt

# auto = use CUDA if available, else CPU.
LANDSLIDE_DEVICE=auto

# Probability threshold (0-1) above which a pixel is classed as landslide.
LANDSLIDE_THRESHOLD=0.5

# Sliding-window patch size the model was trained on. Do not change unless
# using a checkpoint trained at a different resolution.
LANDSLIDE_PATCH_SIZE=128

# Pixel overlap between adjacent patches, blended on reconstruction.
LANDSLIDE_PATCH_OVERLAP=16

# Patches per inference batch (CPU: keep small; raise if running on GPU).
LANDSLIDE_BATCH_SIZE=8

# --- North East rainfall LSTM (see src/nershield_ml/northeast_rainfall/, src/ne_rainfall/) ---
# real = load and run the checkpoint at NORTHEAST_RAINFALL_MODEL_PATH via the
#        vendored ne_rainfall.RainfallForecaster.
# demo = deterministic, clearly-labeled placeholder pipeline (no checkpoint
#        needed); every API response carries mode="demo".
# A trained checkpoint with genuine measured skill now ships at
# Models/northeast_lstm_torch.pt (mean_corr_scaled ~0.46, beats persistence at
# every lead time — see reports/MODEL_COMPARISON.md in the source project).
# The earlier smoke_test_DO_NOT_USE.pt (mean_corr_scaled ~ -0.05, no measured
# skill) is superseded by it. Still NOT committed to this repo (models/ is
# gitignored) — each environment must place its own copy.
NORTHEAST_RAINFALL_MODEL_ENABLED=true
NORTHEAST_RAINFALL_INFERENCE_MODE=real

# Path to a checkpoint written by ne_rainfall.train.save_checkpoint (carries
# weights + scaler + station/block order + horizon in one self-describing
# file — unlike the original Mumbai repo's bare state_dict). Not committed
# to this repo (models/ is gitignored).
NORTHEAST_RAINFALL_MODEL_PATH=./models/northeast_lstm_torch.pt

# Optional second checkpoint (a directory, not a file — XGBoost boosters +
# forecaster_meta.json, written by ne_rainfall.train_xgb). When set and it
# loads successfully alongside NORTHEAST_RAINFALL_MODEL_PATH, real-mode
# forecasts become the mean of both models (ne_rainfall.EnsembleForecaster)
# and the API response's confidence/confidence_available fields are
# populated from their disagreement. Leaving this unset is not an error —
# real mode still runs on the LSTM alone with confidence_available=false,
# exactly as before this existed.
NORTHEAST_RAINFALL_XGB_MODEL_PATH=./models/northeast_xgb_rainfall

# auto = use CUDA if available, else CPU.
NORTHEAST_RAINFALL_DEVICE=auto

# Forecast horizon in hours — informational only; the checkpoint's own
# architecture fixes this at 12h (12 x 1-hour steps). Changing this value
# does not change the model's actual output length.
NORTHEAST_RAINFALL_FORECAST_HOURS=12
